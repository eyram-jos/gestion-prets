<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Gestion des prêts{% endblock %}</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 0; background: #f5f6fa; color: #222; }
        header { background: #4b2e83; padding: 14px 24px; }
        header a { color: #fff; text-decoration: none; font-weight: bold; }
        main { max-width: 1000px; margin: 24px auto; padding: 0 16px; }
        table { border-collapse: collapse; width: 100%; background: #fff; margin-bottom: 24px; }
        th, td { border: 1px solid #ddd; padding: 8px 10px; text-align: left; }
        th { background: #ece8f5; }
        .nombre { text-align: right; }
        .fil { font-size: 14px; }
        .badge { padding: 2px 8px; border-radius: 10px; font-size: 12px; color: #fff; }
        .en-cours { background: #2e8b57; }
        .cloture { background: #888; }
        .vide { color: #777; font-style: italic; }
        .total td { font-weight: bold; background: #f0f0f0; }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body>
<header><a href="{{ path('groupement_index') }}">Gestion des prêts</a></header>
<main>
    {% block body %}{% endblock %}
</main>
</body>
</html>