{% extends 'base.html.twig' %}

{% block title %}Groupements{% endblock %}

{% block stylesheets %}
    <style>
        .filtre { display: flex; gap: 12px; align-items: flex-end; flex-wrap: wrap; background: #fff; padding: 12px 16px; border: 1px solid #ddd; margin-bottom: 16px; }
        .filtre label { display: block; font-size: 13px; margin-bottom: 4px; }
        .filtre input { padding: 6px 8px; border: 1px solid #bbb; border-radius: 4px; }
        .filtre button { padding: 7px 14px; background: #4b2e83; color: #fff; border: 0; border-radius: 4px; cursor: pointer; }
        .pagination { display: flex; gap: 6px; align-items: center; flex-wrap: wrap; }
        .pagination a, .pagination span { padding: 4px 10px; border: 1px solid #ddd; background: #fff; text-decoration: none; }
        .pagination .courante { background: #4b2e83; color: #fff; border-color: #4b2e83; }
        .pagination .inactif { color: #aaa; }
    </style>
{% endblock %}

{% block body %}
    <h1>Groupements</h1>

    {{ form_start(form, {attr: {class: 'filtre'}}) }}
        {{ form_row(form.tel) }}
        {{ form_row(form.ville) }}
        {{ form_widget(form.rechercher) }}
        <a href="{{ path('groupement_index') }}">Réinitialiser</a>
    {{ form_end(form) }}

    {% if liste.lignes is empty %}
        <p class="vide">Aucun groupement ne correspond à la recherche.</p>
    {% else %}
        <table>
            <thead>
                <tr>
                    <th>Nom</th>
                    <th>Téléphone</th>
                    <th>Adresse</th>
                    <th class="nombre">Membres</th>
                    <th class="nombre">Exercices en cours</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for ligne in liste.lignes %}
                    <tr>
                        <td>{{ ligne.nom }}</td>
                        <td>{{ ligne.tel }}</td>
                        <td>{{ ligne.adresse }}</td>
                        <td class="nombre">{{ ligne.nbMembres }}</td>
                        <td class="nombre">{{ ligne.nbExercicesEnCours }}</td>
                        <td><a href="{{ path('groupement_show', {id: ligne.id}) }}">Voir la fiche</a></td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

        <p>Page {{ liste.page }} sur {{ liste.nbPages }} — {{ liste.total }} groupement(s)</p>

        {% if liste.nbPages > 1 %}
            <nav class="pagination" aria-label="Pagination">
                {% if liste.aPagePrecedente %}
                    <a href="{{ path('groupement_index', {tel: filtre.tel, ville: filtre.ville, page: liste.page - 1}) }}">Précédent</a>
                {% else %}
                    <span class="inactif">Précédent</span>
                {% endif %}

                {% for n in 1..liste.nbPages %}
                    {% if n == liste.page %}
                        <span class="courante">{{ n }}</span>
                    {% else %}
                        <a href="{{ path('groupement_index', {tel: filtre.tel, ville: filtre.ville, page: n}) }}">{{ n }}</a>
                    {% endif %}
                {% endfor %}

                {% if liste.aPageSuivante %}
                    <a href="{{ path('groupement_index', {tel: filtre.tel, ville: filtre.ville, page: liste.page + 1}) }}">Suivant</a>
                {% else %}
                    <span class="inactif">Suivant</span>
                {% endif %}
            </nav>
        {% endif %}
    {% endif %}
{% endblock %}